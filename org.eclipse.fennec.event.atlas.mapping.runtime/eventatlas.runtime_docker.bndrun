# Self-contained docker runtime: the SensiNact mapping engine + gateway + northbound
# REST API. Provider mappings and mapping profiles are loaded from XMI files below
# /opt/eventatlas/runtime, wired by the docker.config configurator bundle - no Model
# Atlas connection, no test simulator. (configurator.initial is NOT used: the initial-
# config pass runs before the JSON provider is wired and fails with "Invalid JSON".)
-runprovidedcapabilities: ${native_capability}

-resolve.effective: active

# Deployment-specific values (broker host/credentials, Model Atlas base.uri) are NOT baked
# in: the ConfigAdmin interpolation plugin resolves $[env:...] / $[secret:...] placeholders
# in config.json at delivery time, so one published image serves every environment.
#
# Kept in sync with launch.bndrun: the Model Atlas REST client + Atlas-backed EObject
# provider (mappings come from the Model Atlas service, not only local XMI files) and the
# MQTT/REST southbound adapters that feed payloads in.
-runrequires: \
	osgi.identity;filter:='(osgi.identity=org.apache.felix.gogo.shell)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.gogo.command)',\
	bnd.identity;id='org.apache.felix.configurator',\
	bnd.identity;id='org.eclipse.fennec.event.atlas.mapping',\
	bnd.identity;id='org.eclipse.fennec.event.atlas.mapping.docker.config',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.eobject.registry',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component.minimal',\
	bnd.identity;id='org.eclipse.sensinact.gateway.core.impl',\
	bnd.identity;id='org.apache.aries.typedevent.bus',\
	bnd.identity;id='org.eclipse.sensinact.gateway.northbound.session.session-impl',\
	bnd.identity;id='org.eclipse.sensinact.gateway.northbound.query-handler-impl',\
	bnd.identity;id='org.eclipse.sensinact.gateway.northbound.rest',\
	bnd.identity;id='org.eclipse.sensinact.gateway.northbound.gogo-shell',\
	bnd.identity;id='org.eclipse.sensinact.gateway.northbound.sensorthings.rest.gateway',\
	bnd.identity;id='org.eclipse.sensinact.gateway.northbound.sensorthings.mqtt',\
	bnd.identity;id='org.eclipse.osgitech.rest',\
	bnd.identity;id='tools.jackson.module.jackson-module-jakarta-xmlbind-annotations',\
	bnd.identity;id='slf4j.simple',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.rest.client.impl',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.rest.client.osgi',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.eobject.provider',\
	bnd.identity;id='org.eclipse.fennec.event.atlas.mqtt.southbound.adapter',\
	bnd.identity;id='org.eclipse.fennec.event.atlas.rest.southbound.adapter',\
	bnd.identity;id='org.apache.felix.configadmin.plugin.interpolation'

-runproperties: \
    osgi.console=,\
    org.osgi.service.http.port=-1,\
    osgi.console.enable.builtin=false,\
    felix.cm.config.plugins=org.apache.felix.configadmin.plugin.interpolation

-runee: JavaSE-21
-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'

# The spifly framework-extension variant breaks the typedevent bus at startup
# ("Weaving hook failed"); force the classic spifly dynamic bundle instead.
-runblacklist: \
	bnd.identity;id='org.apache.aries.spifly.dynamic.framework.extension'

-runbundles: \
	com.fasterxml.jackson.core.jackson-annotations;version='[2.21.0,2.21.1)',\
	com.fasterxml.jackson.core.jackson-core;version='[2.19.2,2.19.3)',\
	io.dropwizard.metrics.core;version='[4.2.37,4.2.38)',\
	jakarta.activation-api;version='[2.1.3,2.1.4)',\
	jakarta.annotation-api;version='[2.1.1,2.1.2)',\
	jakarta.inject.jakarta.inject-api;version='[2.0.1,2.0.2)',\
	jakarta.validation.jakarta.validation-api;version='[3.0.2,3.0.3)',\
	jakarta.ws.rs-api;version='[3.1.0,3.1.1)',\
	jakarta.xml.bind-api;version='[4.0.2,4.0.3)',\
	javassist;version='[3.29.2,3.29.3)',\
	org.apache.aries.component-dsl.component-dsl;version='[1.2.2,1.2.3)',\
	org.apache.aries.spifly.dynamic.bundle;version='[1.3.7,1.3.8)',\
	org.apache.aries.typedevent.bus;version='[1.0.1,1.0.2)',\
	org.apache.felix.cm.json;version='[2.0.6,2.0.7)',\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)',\
	org.apache.felix.configurator;version='[1.0.18,1.0.19)',\
	org.apache.felix.gogo.command;version='[1.1.2,1.1.3)',\
	org.apache.felix.gogo.runtime;version='[1.1.6,1.1.7)',\
