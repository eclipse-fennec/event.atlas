# Template for secrets.bndrun, which is deliberately NOT in git (see .gitignore next to this
# file). Copy it, fill in the key, and run.launch picks it up through the optional
# `-include: -secrets.bndrun` in launch.bndrun:
#
#     cp secrets.bndrun.template secrets.bndrun
#
# Everything here arrives as a system property. configs/config.json in
# …mapping.local.config reads each value as $[env:NAME;default=$[prop:NAME;default=…]], so an
# exported environment variable takes precedence over what is set here, and a value left out
# falls back to the default in that file. Nothing in this chain ever puts a credential in git.
#
# Without this file the runtime starts exactly as before: model inference activates, finds no
# usable key, and records an UNAVAILABLE receipt on the first unknown payload.
-runvm.secrets: \
	-DANTHROPIC_API_KEY=sk-ant-api03-REPLACE-ME,\
	-DMETAMODEL_MCP_URL=http://localhost:8181/mcp/emf,\
	-DINFERENCE_NAMESPACE=https://fennec.eclipse.org/event.atlas/inferred,\
	-DINFERENCE_MODEL=claude-opus-5,\
	-DINFERENCE_MAX_RUNS=1,\
	-DINFERENCE_DOWNLOAD_FOLDER=/tmp/eventatlas-inference,\
	-DSAMPLING_MAX_WAIT=300
