# Minimal runtime for exercising the model-inference chain.
#
# What this is for: watching one inference run happen, without the rest of the gateway in the
# way. Compared with launch.bndrun it drops the history store (and with it postgresql and the two
# tx-control bundles), the northbound REST gateway, the SensorThings REST gateway and MQTT broker,
# the Jakarta-RS whiteboard and the Felix HTTP service entirely - nothing here serves HTTP.
#
#   MQTT -> PayloadIngest -> (unknown) -> PayloadSampleCollector -> ModelInferenceService
#                                              -> ChatCompletion -> remote MCP server
#
# The sensinact gateway core stays, and cannot be dropped: PayloadIngest has a mandatory
# reference to InstancePusher, whose InstancePusherImpl has a mandatory reference to
# GatewayThread. So the twin is built and written, there is just nothing northbound to read it -
# outcomes are observed in the ingest log instead.
#
# Needs an external MQTT broker on 1883 (mosquitto - see docker/inference/README.md). That port
# is free here exactly because the SensorThings MQTT broker is not deployed.
#
# Credentials and endpoints come from the gitignored secrets.bndrun, same as launch.bndrun.
-include: -secrets.bndrun

-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'
-runee: JavaSE-21

-resolve.effective: active

# The framework-extension spifly variant breaks the typed-event bus at startup ("Weaving hook
# failed") and the sensinact GatewayThread then never activates. Keep the classic
# spifly.dynamic.bundle, exactly as the other three bndruns do.
-runblacklist: \
	bnd.identity;id='org.apache.aries.spifly.dynamic.framework.extension'

# EVENTATLAS_{MAPPINGS,PROFILES}_DIR: where the file providers read from, as absolute paths
# pinned to this project.
#
# config.json defaults them to `runtime/mappings` and `runtime/profiles`, which are resolved
# against the JVM's working directory - fine for `run.inference` (Gradle runs it here), silently
# empty for the exported inference.jar started from anywhere else. FileEObjectProvider logs one
# WARNING for a location that does not exist and then syncs an empty state, so the registry comes
# up with zero entries and every subsequent payload is reported NO_MAPPING. That is what happened
# on 2026-08-28, where a known EM310-UDL payload deserialized correctly and matched nothing.
#
# Two bnd details, both load-bearing, both verified by exporting and reading launcher.properties:
#
#  - -runproperties, NOT -runvm -D. bnd bakes -runproperties into the exported jar's
#    launcher.properties, while -runvm is a set of JVM arguments and there are no JVM arguments
#    left to set once `java -jar` is running. The interpolation plugin's $[prop:...] reads a
#    framework property, so the value arrives whichever way the framework was started.
#  - ${.}, NOT ${basedir}. An export processes a staged copy of this file, so ${basedir} and
#    ${project} both expand to generated/tmp/export.inference/... - a directory that does not
#    survive the build. ${.} is the directory of the file itself and expands to this project.
#
# The docker bndrun needs none of this: its config names absolute paths under /opt/eventatlas.
-runproperties: \
	org.osgi.service.http.port=-1,\
	felix.cm.config.plugins=org.apache.felix.configadmin.plugin.interpolation,\
	org.osgi.framework.bootdelegation='sun.*,com.sun.*',\
	EVENTATLAS_MAPPINGS_DIR=${.}/runtime/mappings,\
	EVENTATLAS_PROFILES_DIR=${.}/runtime/profiles

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component.minimal',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.eobject.registry',\
	bnd.identity;id='org.eclipse.fennec.event.atlas.mapping',\
	bnd.identity;id='org.eclipse.fennec.event.atlas.southbound.common',\
	bnd.identity;id='org.eclipse.fennec.event.atlas.mqtt.southbound.adapter',\
	bnd.identity;id='org.eclipse.fennec.event.atlas.mapping.inference.config',\
	bnd.identity;id='org.eclipse.fennec.codec',\
	bnd.identity;id='org.eclipse.fennec.codec.jsonschema',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.rest.client.impl',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.rest.client.osgi',\
	bnd.identity;id='org.eclipse.sensinact.gateway.core.impl',\
	bnd.identity;id='org.eclipse.sensinact.gateway.southbound.mqtt.mqtt-client',\
	bnd.identity;id='org.apache.aries.typedevent.bus',\
	bnd.identity;id='org.apache.felix.configadmin.plugin.interpolation',\
	bnd.identity;id='org.eclipse.fennec.event.atlas.southbound.sampling',\
	bnd.identity;id='org.eclipse.fennec.event.atlas.model.inference',\
	bnd.identity;id='org.eclipse.fennec.event.atlas.model.inference.chat',\
	bnd.identity;id='org.eclipse.fennec.ai.chat.completion.impl.claude',\
	bnd.identity;id='org.apache.felix.gogo.shell',\
	bnd.identity;id='org.apache.felix.gogo.command',\
	bnd.identity;id='org.eclipse.fennec.mcp.endpoint'

