<?xml version="1.0" encoding="UTF-8"?>
<!--
  ILSA - a signal state update (topic 5g/ilsa/<intersection>/.../<signal>).
  Replaces: IlsaListener.updateSignal + TrafficLightDto.

  STATUS 2026-11-06
    DONE  the service is named by the payload, and typed Signal - the same EClass the
          configuration mapping names, which is what keeps the two flows on one service
                                                               (#91 items 5 and 8)
    DONE  the '/' -> '_' rewrite the adapter does in Java, as OCL replaceAll (#91 item 2)
    DONE  one provider for both ILSA flows, through ilsa-profile.xmi (UNIFIED)
    DONE  the color value and the payload timestamp. The unit metadata now comes from
          Signal.color's own annotation, not from this mapping                (#91 item 8)
    OPEN  the provider id. The intersection is in the MQTT topic, not in the payload.
          Not an event.atlas change: it needs a transient `intersectionId` on
          TLSignalState, added LAST in the EClass. The mapping below assumes it.

  This mapping is complete except for that one attribute.
-->
<sensinactMapping:ProviderMapping
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    xmlns:sensinactMapping="https://fennec.eclipse.org/event.atlas/mapping/1.0"
    mid="ilsa-signal-state"
    providerTimestamp="false">

  <!-- The intersection, which the adapter copies from the topic into the payload.
       TODO(gap 1): needs TLSignalState.intersectionId, transient, added LAST in the EClass. -->
  <name>
    <featurePath xsi:type="ecore:EAttribute"
        href="http://jena.de/udp/trafficos/trafficlight/1.1.1#//TLSignalState/intersectionId"/>
  </name>

  <!-- Both ILSA mappings name this profile, whose providerStrategy is UNIFIED, so both
       build the same model and their payloads reach ONE provider. The fragment is the
       profileId, not "/": that is what ProviderMappingRegistryImpl looks up in the profile
       registry when the document itself is not reachable - which is the normal case for a
       mapping delivered from a Model Atlas. -->
  <profile href="ilsa-profile.xmi#ilsa"/>

  <providerClasses href="http://jena.de/udp/trafficos/trafficlight/1.1.1#//TLSignalState"/>

  <!-- The payload decides the service: signalState.id with '/' replaced, exactly as
       IlsaListener.updateSignal does it in Java. A producer on the name is what makes the
       engine read it, and the service is created on the provider the first time it appears.

       serviceEClass names the same Signal EClass the configuration mapping uses. Both flows
       then write the same service of the same type, which is what the adapter does - and the
       two must still share one provider, through the UNIFIED profile that is still to write. -->
  <services mid="signal">
    <name expression="self.id.replaceAll('/', '_')"/>
    <serviceEClass href="https://model.data.jena.de/sensinact/ilsa/1.0#//Signal"/>

    <timestamp>
      <featurePath xsi:type="ecore:EAttribute"
          href="http://jena.de/udp/trafficos/trafficlight/1.1.1#//TLSignalState/timestamp"/>
    </timestamp>

    <!-- The Ilsa package carries the type and the `sensorthings.unit.name` annotation on
         Signal.color, and a typed service takes both from there - so this block only says
         where the value comes from. -->
    <resources mid="color">
      <valueMapping>
        <featurePath xsi:type="ecore:EAttribute"
            href="http://jena.de/udp/trafficos/trafficlight/1.1.1#//TLSignalState/state"/>
      </valueMapping>
    </resources>
  </services>

  <admin mid="admin">
    <name name="Admin"/>
  </admin>
</sensinactMapping:ProviderMapping>
