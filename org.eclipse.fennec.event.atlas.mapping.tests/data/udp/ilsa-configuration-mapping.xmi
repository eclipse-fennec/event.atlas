<?xml version="1.0" encoding="UTF-8"?>
<!--
  ILSA - the intersection configuration (topic .../config/retained).
  Replaces: ilsa.qvto + IlsaListener.updateConfig.

  STATUS 2026-11-06
    DONE  each service typed Signal, the EClass de.jena.ilsa.sensinact.model declares, so
          `color` and `observedArea` carry its types and its Metadata annotations (#91 item 8)
    DONE  one service for each TLSignal, from ONE block. The signals sit three nested
          collections deep (subcircles -> serialPorts -> modules -> signals), which the
          qvto walks with collect().collect().collect()                      (#91 item 5)
    DONE  each service named from its own signal, '/' rewritten, as OCL      (#91 item 2)
    DONE  the admin friendly name, 'ILSA ' + intersectionName - a literal combined with a
          feature, which a bare feature path cannot express                  (#91 item 7)
    DONE  the admin location out of geoJson.bbox, two numbers inside ONE Double[] value.
          Needs the `at` operation contributed by the model bundle, and
          ocl.customOperationsEnabled=true on PID DefaultOclEngine           (#91 item 7)
    DONE  observedArea through a ValueConverter, replacing the qvto black box (#91 item 1)
    DONE  the `type` and `signalGroup` metadata on the color resource, read from the
          signal on every push                                               (#91 item 6)
    DONE  one provider for both ILSA flows, through ilsa-profile.xmi (UNIFIED)
    OPEN  nothing in this mapping.

    NOT HERE. `Ilsa.thermal` is typed Thermal, which extends Admin, and a typed service may
    be an Admin subclass - item 8 covers it. It is not in this mapping because the thermal
    topic carries a bare number and no EObject, so the engine never sees that flow. When the
    adapter wraps it, one <services mid="thermal"> with
    serviceEClass=.../sensinact/ilsa/1.0#//Thermal expresses it.

  TWO MAPPINGS, ONE PROVIDER. The adapter pushes both flows into one `Ilsa` provider named
  after the intersection. A mapping's provider model comes from its own `fqMid` unless a
  MappingProfile with providerStrategy=UNIFIED names one - ilsa-profile.xmi, which both
  mappings reference below. Deploy it into the `sensinact-profiles` registry beside them: a
  mapping whose profile cannot be resolved is skipped entirely.
-->
<sensinactMapping:ProviderMapping
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    xmlns:sensinactMapping="https://fennec.eclipse.org/event.atlas/mapping/1.0"
    mid="ilsa-configuration"
    providerTimestamp="true">

  <!-- qvto: id := self.intersectionId -->
  <name>
    <featurePath xsi:type="ecore:EAttribute"
        href="http://jena.de/udp/trafficos/trafficlight/1.1.1#//TLConfiguration/intersectionId"/>
  </name>

  <!-- Both ILSA mappings name this profile, whose providerStrategy is UNIFIED, so both
       build the same model and their payloads reach ONE provider. The fragment is the
       profileId, not "/": that is what ProviderMappingRegistryImpl looks up in the profile
       registry when the document itself is not reachable - which is the normal case for a
       mapping delivered from a Model Atlas. -->
  <profile href="ilsa-profile.xmi#ilsa"/>

  <providerClasses href="http://jena.de/udp/trafficos/trafficlight/1.1.1#//TLConfiguration"/>

  <!--
    qvto: services := self.subcircles->collect(serialPorts)->collect(modules)->collect(signals)
    One block, one service for each signal: the path keeps the collection and the name is
    produced, so the engine makes one service per element and creates it on the model.
    The '/' -> '_' rewrite is the same one IlsaListener does in Java.
  -->
  <services mid="signal">
    <name expression="self.id.replaceAll('/', '_')"/>

    <!--
      The service the adapter builds: Signal, from de.jena.ilsa.sensinact.model. The twin
      builds the service from this EClass, so `color` and `observedArea` carry the types AND
      the Metadata annotations it declares - which is why neither eType nor extraMetadata is
      restated below any more. A typed service takes its metadata from the EClass; a
      <metadata> block is unaffected, because it is written per push.

      A serviceEClass and a produced name combine: one block, one Signal-typed service for
      each element the path below reaches.
    -->
    <serviceEClass href="https://model.data.jena.de/sensinact/ilsa/1.0#//Signal"/>

    <!-- selector only: exclude="false" with no filter generates no resources. It stays: a
         referencedResource is also the path that picks each service's source element. -->
    <referencedResource exclude="false">
      <featurePath xsi:type="ecore:EReference"
          href="http://jena.de/udp/trafficos/trafficlight/1.1.1#//TLConfiguration/subcircles"/>
      <featurePath xsi:type="ecore:EReference"
          href="http://jena.de/udp/trafficos/trafficlight/1.1.1#//Subcircle/serialPorts"/>
      <featurePath xsi:type="ecore:EReference"
          href="http://jena.de/udp/trafficos/trafficlight/1.1.1#//SerialPort/modules"/>
      <featurePath xsi:type="ecore:EReference"
          href="http://jena.de/udp/trafficos/trafficlight/1.1.1#//TLModule/signals"/>
    </referencedResource>

    <!--
      qvto: observedArea := self.observedArea.convertToFeatureCollection()
      The black box becomes a ValueConverter the UDP side publishes under this id. The
      converter whiteboard is in place; only the converter itself has to be written.
    -->
    <resources mid="observedArea">
      <valueMapping converterId="udp.geojson.featurecollection">
        <featurePath xsi:type="ecore:EReference"
            href="http://jena.de/udp/trafficos/trafficlight/1.1.1#//TLSignal/observedArea"/>
      </valueMapping>
    </resources>

    <!--
      IlsaListener.describeSignal writes `type` and `signalGroup` on the color resource, and
      both values come from the signal. extraMetadata holds constants only, so these are
      MetadataMappings - a FeatureMapping with a key, read on every push.

      The resource carries no value here: the configuration describes the signal, and the
      signal-state mapping fills the colour. Declaring it is what gives the metadata somewhere
      to live - and with serviceEClass the Signal EClass declares it anyway, including its
      `sensorthings.unit.name` annotation.
    -->
    <resources mid="color">
      <metadata key="type">
        <featurePath xsi:type="ecore:EAttribute"
            href="http://jena.de/udp/trafficos/trafficlight/1.1.1#//TLSignal/signalType"/>
      </metadata>
      <metadata key="signalGroup">
        <featurePath xsi:type="ecore:EReference"
            href="http://jena.de/udp/trafficos/trafficlight/1.1.1#//TLSignal/signalGroup"/>
        <featurePath xsi:type="ecore:EAttribute"
            href="http://jena.de/udp/trafficos/trafficlight/1.1.1#//TLSignalGroup/id"/>
      </metadata>
    </resources>

  </services>

  <admin mid="admin">
    <!--
      qvto: friendlyName := 'ILSA ' + self.intersectionName.
      A friendlyNameMapping takes an expression, which a bare feature path cannot.
    -->
    <name name="Admin"/>
    <friendlyNameMapping expression="'ILSA ' + self.intersectionName"/>

    <!--
      IlsaListener.location builds Point(geoJson.bbox[0], geoJson.bbox[1]).
      `bbox` is ONE attribute of datatype Array1D, instance class java.lang.Double[], so no
      feature path and no collectionIndex reaches an element, and no OCL *collection* operation
      does either - to the standard library the array is a single scalar.
      An OclOperation contributed ON the datatype does: `at` is published by the model's own
      bundle as an OclOperationProvider. Every published provider binds, so contributions
      compose; the runtime only has to set ocl.customOperationsEnabled=true on PID
      DefaultOclEngine. Measured in ContributedOperationTest.
    -->
    <longitudeMapping expression="self.geoJson.bbox.at(1)"/>
    <latitudeMapping expression="self.geoJson.bbox.at(2)"/>

  </admin>
</sensinactMapping:ProviderMapping>
