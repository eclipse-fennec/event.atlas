Bundle-Name: Fennec Event Atlas :: SensiNact Mapping Tests
Bundle-Description: OSGi integration tests for the SensiNact mapping: provider/profile registration through the whiteboard, feature-path value mapping onto the digital twin, and persistence-rule round-trips.

Test-Cases: ${classes;HIERARCHY_INDIRECTLY_ANNOTATED;org.junit.platform.commons.annotation.Testable;CONCRETE}


src=${^src},src-gen
-workingset: SensiNact

-library: \
	enableOSGi-Test,\
	enableEMF
	
-generate:\
	model/lora-test.genmodel;\
		generate=fennecEMF;\
		genmodel=model/lora-test.genmodel;\
		output=src-gen

# sets the usually required buildpath using the bnd library, you can extend it with the normal -buildpath to your liking
-buildpath: \
	org.osgi.framework;version=latest,\
	org.osgi.util.promise;version=latest,\
	org.osgi.service.typedevent;version=latest,\
	org.eclipse.sensinact.gateway.core.annotation;version=latest,\
	org.eclipse.sensinact.gateway.core.api;version=latest,\
	org.eclipse.sensinact.gateway.core.models.provider;version=latest,\
	org.eclipse.sensinact.gateway.core.geo-json;version=latest,\
	org.gecko.weather.model;version=latest,\
	org.eclipse.fennec.emf.osgi.component.minimal;version=latest,\
	org.eclipse.fennec.emf.osgi.eobject.registry;version=latest,\
	org.eclipse.fennec.event.atlas.mapping;version=snapshot

-includeresource: \
	data=data,\
	model=model
	
Bundle-Version: 1.0.0.SNAPSHOT

# Sometimes without DynamicImport Mockito will not find certain classes
#DynamicImport-Package: *
