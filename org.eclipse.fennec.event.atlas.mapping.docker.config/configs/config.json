{
  ":configurator:resource-version": 1,
  ":configurator:symbolic-name": "org.eclipse.fennec.event.atlas.mapping.docker.config",
  ":configurator:version": "1.0.0",

  /*
   * Deployment-specific values are $[env:...] placeholders, resolved at configuration-delivery
   * time by org.apache.felix.configadmin.plugin.interpolation (enabled through the bndrun's
   * felix.cm.config.plugins property). Every placeholder carries a default, so the image still
   * starts standalone; set the variables in the container environment to point it at a real
   * Model Atlas and MQTT broker. Comments are legal here - the Configurator reads this file
   * through Felix cm.json's comment-aware reader.
   */

  /* Mappings come from the Model Atlas service. The file provider below stays as the registry's
   * initial content, so mounted XMIs still seed it; the Atlas provider syncs on top. */
  "org.eclipse.fennec.model.atlas.rest.client~atlas": {
    "base.uri": "$[env:EVENTATLAS_ATLAS_BASE_URI;default=http://localhost:8086/atlas/rest]",
    "scope.allow.list": ["$[env:EVENTATLAS_ATLAS_SCOPE;default=jena]"],
    "default.scope": "$[env:EVENTATLAS_ATLAS_SCOPE;default=jena]",
    /* Domain EPackages come from the Atlas too, not from model bundles baked into the image.
     * EAGER pre-fetches them at activation so the mapping sync below finds them; the stage
     * name is the scope's final stage - "release" in the jena scope, NOT the client default
     * "released". They reach both the codec and the mapping sync through the OSGi framework
     * EPackage.Registry - the metadata whiteboard - which is all this block configures. */
    "mode": "EAGER",
    "eager.scopes": ["$[env:EVENTATLAS_ATLAS_SCOPE;default=jena]"],
    "eager.stages": ["$[env:EVENTATLAS_ATLAS_STAGE;default=release]"],
    /* No `register.in.global.registry` and no `nsuri.deny.list`: both came out on 2026-09-08,
     * because they were one workaround for two upstream bugs that are now fixed.
     *
     * The chain was: an EAGER sweep resolves scope inheritance, so it also swept the packages
     * owned by the implicit `atlas` parent - Ecore, UML, XMLType, the atlas APIs, the codec,
     * this workspace's own mapping metamodel. The mirror then copied each into
     * EPackage.Registry.INSTANCE, and a DYNAMIC copy of a system nsURI landing there before the
     * generated package had initialised broke that package's factory initialiser
     * (ClassCastException: EFactoryImpl cannot be cast to ScopeApiFactory). A hand-maintained
     * 17-entry deny-list suppressed the mirror for those nsURIs.
     *
     * - fennec-codec #207 (published 0.1.0.202609080603-SNAPSHOT) is why the mirror was ever
     *   needed: TypeResolutionHelper resolved an nsURI straight out of
     *   EPackage.Registry.INSTANCE, which is empty in a runtime that publishes its models
     *   through the metadata whiteboard. Type resolution now goes through the per-load
     *   PackageResolver, so the mirror can go back to its default false - and with nothing
     *   dynamic reaching the EMF singleton, the ordering hazard is removed rather than dodged.
     * - model.atlas c37f91d (published 2026-09-07) replaces the deny-list: LocalGeneratedPackages
     *   reads the org.eclipse.emf.ecore.generated_package capability every generated model bundle
     *   carries, so local-first suppression sees what a bundle DECLARES from the moment it is
     *   installed. Unlike the list it is not tied to a scope and needs no maintenance.
     *
     * `AtlasEObjectProvider~atlas`'s `required.nsuris` gate below does not depend on the mirror:
     * its `packageRegistry` reference defaults to the framework registry
     * (default.resourceset.epackage.registry=true) and AtlasObjectSync pins only those few
     * nsURIs into the singleton itself, value-matched and never over an occupied slot.
     *
     * Verified in inference.bndrun on 2026-09-08 (`published 14 EPackage(s)`, no
     * ClassCastException, `1 mapping(s) applied`). NOT yet re-verified in this image. */
    "drift.check.interval.ms": "$[env:EVENTATLAS_ATLAS_DRIFT_INTERVAL_MS;default=10000;type=Long]"
  },

  "FileEObjectProvider~mappings": {
    "emf.eobject.provider.name": "mapping-files",
    "locations": ["/opt/eventatlas/runtime/mappings"],
    "key.feature": "mid"
  },

  "EObjectRegistry~mappings": {
    "name": "sensinact-mappings",
    "initialProvider.target": "(emf.eobject.provider.name=mapping-files)"
  },

  "AtlasEObjectProvider~atlas": {
    "atlasScope.target": "(atlas.scope=$[env:EVENTATLAS_ATLAS_SCOPE;default=jena])",
    "writer.target": "(emf.eobject.registry.name=sensinact-mappings)",
    "emf.eobject.provider.name": "atlas-mappings",
    "registries": ["$[env:EVENTATLAS_ATLAS_REGISTRY;default=sensinactmapping]"],
    "key.feature": "mid",
    /* Gate, not a loader: the sync pass is postponed until these EPackages are registered.
     * The mapping metamodel comes from the mapping bundle, the domain models from the Atlas
     * (see the client above). Add every domain nsURI you map here. */
    "required.nsuris": [
      "https://fennec.eclipse.org/event.atlas/mapping/1.0",
      "$[env:EVENTATLAS_DOMAIN_NSURI;default=https://datainmotion.de/demo/m5airq/1.0]"
    ],
    "refresh.interval.ms": "$[env:EVENTATLAS_ATLAS_REFRESH_INTERVAL_MS;default=60000;type=Long]"
  },

  /* Deployment models. Empty by default, and inert while it stays empty: the registry binds the
   * DeploymentConfigurator, which writes nothing until an EventAtlasDeployment turns up.
   *
   * Drop an XMI into the mounted /opt/eventatlas/runtime/deployment and its sections are applied
   * as ConfigAdmin configurations. Sections it does not declare keep coming from these JSON files,
   * and a PID one of these files already owns is left alone with a warning - see
   * model/examples/deployment-history-tuning.xmi for the step that collides with nothing. */
  "FileEObjectProvider~deployment": {
    "emf.eobject.provider.name": "deployment-files",
    "locations": ["/opt/eventatlas/runtime/deployment"],
    "key.feature": "deploymentId"
  },

  "EObjectRegistry~deployment": {
    "name": "event-atlas-deployment",
    "initialProvider.target": "(emf.eobject.provider.name=deployment-files)"
  },

  "FileEObjectProvider~profiles": {
    "emf.eobject.provider.name": "profile-files",
    "locations": ["/opt/eventatlas/runtime/profiles"],
    "key.feature": "profileId"
  },

  "EObjectRegistry~profiles": {
    "name": "sensinact-profiles",
    "initialProvider.target": "(emf.eobject.provider.name=profile-files)"
  },

  /* JSON payloads do not name their model; the codec types them through the discriminator
   * registry named here, and its single discriminator path (see docs/json-southbound-typing.md).
   * One registry per runtime - every JSON device family shares it.
   *
   * THIS PID IS NOT OPTIONAL FOR A JSON DEPLOYMENT. PayloadIngestImpl is
   * ConfigurationPolicy.OPTIONAL with `codec.typeMapId` defaulting to "", and an empty map id
   * means no load option is passed at all - the deserializer then finds no type information and
   * drops every JSON payload:
   *   CodecEObjectDeserializer SEVERE: Cannot deserialize: no type information found and no
   *   CODEC_ROOT_TYPE hint
   * The activation line `Payload typing: map '<none>'` is the give-away. Env-interpolated like
   * every other value here, so one published image serves every deployment. */
  "event.atlas.southbound.ingest": {
    "codec.typeMapId": "$[env:EVENTATLAS_CODEC_TYPE_MAP_ID;default=jena-sensors]"
  },

  /* `;type=String[]` is REQUIRED on every list property, not optional next to `delimiter`: the
   * interpolation plugin only converts a value when the `type` directive is present
   * (InterpolationConfigurationPlugin:196 -> convertType), so `delimiter=,` ALONE is silently
   * ignored and the property stays one comma-joined String. sensiNact then hands that whole
   * string to paho, which rejects it with
   *   IllegalArgumentException: Invalid usage of multi-level wildcard in topic string: a/#,b/#
   *
   * MQTT: the sensiNact client is the transport only (connection + subscription); all mapping
   * and ingest happens in event.atlas's MqttPayloadListener, which binds this handler by id.
   *
   * `topics` here is what is SUBSCRIBED at the broker. Which of those messages each ingest
   * channel handles is a separate, per-channel filter — see the two adapter instances below. */
  "sensinact.southbound.mqtt~broker": {
    "id": "eventatlas-broker",
    "protocol": "$[env:EVENTATLAS_MQTT_PROTOCOL;default=tcp]",
    "host": "$[env:EVENTATLAS_MQTT_HOST;default=localhost]",
    "port": "$[env:EVENTATLAS_MQTT_PORT;default=1883;type=Integer]",
    "user": "$[env:EVENTATLAS_MQTT_USER;default=]",
    ".password": "$[env:EVENTATLAS_MQTT_PASSWORD;default=]",
    "topics": "$[env:EVENTATLAS_MQTT_TOPICS;default=eventatlas/#;delimiter=,;type=String[]]"
  },

  /* Two ingest channels on the ONE broker connection above, split by payload format.
   * MqttPayloadListener is a factory pid, and sensiNact dispatches to each registered listener
   * only for the topics matching its own filters (MqttTopic.isMatched), so a message is handled
   * by whichever channel's filter it matches — with the format stated, not guessed.
   *
   * The filters are subsets of the broker's `topics` and are NOT derived from it: a topic that
   * is subscribed but matches neither filter is received and silently dropped. Each channel logs
   * its filters at activation ("MQTT southbound adapter '...' listening on [...]"), which is the
   * quickest way to spot that. Keep the union of the two covering `topics`.
   *
   * A filter that matches nothing is harmless — it costs no subscription — so the JSON channel's
   * default is inert rather than empty (empty topics is a hard activation failure by design). */
  "event.atlas.southbound.mqtt~xmi": {
    "mqttTopics": "$[env:EVENTATLAS_MQTT_XMI_TOPICS;default=eventatlas/#;delimiter=,;type=String[]]",
    "mqtt.handler.id": "eventatlas-broker",
    "format": "xmi",
    "name": "eventatlas-mqtt-xmi"
  },
  "event.atlas.southbound.mqtt~json": {
    "mqttTopics": "$[env:EVENTATLAS_MQTT_JSON_TOPICS;default=eventatlas/json/#;delimiter=,;type=String[]]",
    "mqtt.handler.id": "eventatlas-broker",
    "format": "json",
    "name": "eventatlas-mqtt-json"
  }
}
