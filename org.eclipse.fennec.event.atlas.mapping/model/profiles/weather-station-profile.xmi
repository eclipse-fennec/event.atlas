<?xml version="1.0" encoding="UTF-8"?>
<sensinactMapping:MappingProfile xmi:version="2.0" 
    xmlns:xmi="http://www.omg.org/XMI" 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:sensinactMapping="https://fennec.eclipse.org/event.atlas/mapping/1.0"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    xsi:schemaLocation="https://fennec.eclipse.org/event.atlas/mapping/1.0 ../sensinact-mapping.ecore"
    profileId="weather-station"
    name="Weather Station Profile"
    description="Standard profile for weather station devices that provide comprehensive weather data including temperature, wind, pressure, and precipitation information."
    version="1.0">
    
    <provider providerId="weather-station">
        <admin serviceId="admin" serviceName="Admin" required="true" 
               requiresLocation="true" requiresFriendlyName="true">
            <resources resourceId="friendlyName" resourceName="Station Name" required="true">
                <expectedType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
            </resources>
            <resources resourceId="location" resourceName="Location" required="true">
                <expectedType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
            </resources>
        </admin>
        
        <services serviceId="temperature" serviceName="Temperature" required="true">
            <resources resourceId="temperature" resourceName="Temperature" required="true" 
                       expectedUnit="degrees">
                <expectedType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
            </resources>
            <resources resourceId="min" resourceName="Min Temperature" required="false" 
                       expectedUnit="degrees">
                <expectedType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
            </resources>
            <resources resourceId="max" resourceName="Max Temperature" required="false" 
                       expectedUnit="degrees">
                <expectedType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
            </resources>
        </services>
        
        <services serviceId="wind" serviceName="Wind" required="true">
            <resources resourceId="speed" resourceName="Speed" required="true" 
                       expectedUnit="m/s">
                <expectedType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
            </resources>
            <resources resourceId="direction" resourceName="Direction" required="true" 
                       expectedUnit="degrees">
                <expectedType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
            </resources>
        </services>
        
        <services serviceId="pressure" serviceName="Pressure" required="true">
            <resources resourceId="surface" resourceName="Surface Pressure" required="true" 
                       expectedUnit="Pa">
                <expectedType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
            </resources>
        </services>
        
        <services serviceId="cloud" serviceName="Cloud" required="false">
            <resources resourceId="coverage" resourceName="Coverage" required="true" 
                       expectedUnit="%">
                <expectedType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
            </resources>
        </services>
        
        <services serviceId="rain" serviceName="Rain" required="false">
            <resources resourceId="no-rain" resourceName="Probabilty no rain" required="false" 
                       expectedUnit="%">
                <expectedType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
            </resources>
            <resources resourceId="2mm" resourceName="Rain probability 2mm" required="false" 
                       expectedUnit="%">
                <expectedType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
            </resources>
            <resources resourceId="10mm" resourceName="Rain probability 10mm" required="false" 
                       expectedUnit="%">
                <expectedType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
            </resources>
            <resources resourceId="50mm" resourceName="Rain probability 50mm" required="false" 
                       expectedUnit="%">
                <expectedType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
            </resources>
        </services>
        
        <services serviceId="warning" serviceName="Weather Warning" required="false">
            <resources resourceId="signifanct" resourceName="Significant Weather" required="false">
                <expectedType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
            </resources>
        </services>
    </provider>
</sensinactMapping:MappingProfile>