<?xml version="1.0" encoding="UTF-8"?>
<sensinactMapping:ProviderMapping
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    xmlns:sensinactMapping="https://fennec.eclipse.org/event.atlas/mapping/1.0"
    xsi:schemaLocation="https://fennec.eclipse.org/event.atlas/mapping/1.0 ../sensinact-mapping.ecore"
    mid="dwd-weather-with-profile"
    providerTimestamp="true">
    
  <!-- Reference to the weather station profile -->
  <profile href="../profiles/weather-station-profile.xmi#/"/>
  
  <timestamp strategy="FEATURE">
    <featurePath
        xsi:type="ecore:EAttribute"
        href="http://cdc.dwd.de/common/weather#//WeatherReport/timestamp"/>
  </timestamp>
  
  <name name="DWD Weather with Profile"/>
  
  <providerClasses
      href="http://cdc.dwd.de/common/weather#//MOSMIXSWeatherReport"/>
      
  <services
      xsi:type="sensinactMapping:AdminMapping"
      mid="admin">
    <friendlyNameFeature
        xsi:type="ecore:EReference"
        href="http://cdc.dwd.de/common/weather#//WeatherReport/station"/>
    <friendlyNameFeature
        xsi:type="ecore:EAttribute"
        href="http://cdc.dwd.de/common/weather#//Station/name"/>
    <providerPackage
        href="http://cdc.dwd.de/common/weather#/"/>
    <latitudeRef
        xsi:type="ecore:EReference"
        href="http://cdc.dwd.de/common/weather#//WeatherReport/station"/>
    <latitudeRef
        xsi:type="ecore:EReference"
        href="http://cdc.dwd.de/common/weather#//Station/location"/>
    <latitudeRef
        xsi:type="ecore:EAttribute"
        href="http://cdc.dwd.de/common/weather#//GeoPosition/latitude"/>
    <longitudeRef
        xsi:type="ecore:EReference"
        href="http://cdc.dwd.de/common/weather#//WeatherReport/station"/>
    <longitudeRef
        xsi:type="ecore:EReference"
        href="http://cdc.dwd.de/common/weather#//Station/location"/>
    <longitudeRef
        xsi:type="ecore:EAttribute"
        href="http://cdc.dwd.de/common/weather#//GeoPosition/longitude"/>
  </services>
  
  <!-- Services that conform to the weather-station profile -->
  <services mid="wind">
    <name name="Wind"/>
    <resources
        name="Speed"
        changeable="false"
        defaultValueLiteral="0"
        unit="m/s"
        mid="speed">
      <eType
          xsi:type="ecore:EDataType"
          href="http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
      <valueFeature
          xsi:type="ecore:EAttribute"
          href="http://cdc.dwd.de/common/weather#//MOSMIXSWeatherReport/windSpeed"/>
    </resources>
    <resources
        name="Direction"
        unit="degrees"
        mid="direction">
      <eType
          xsi:type="ecore:EDataType"
          href="http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <valueFeature
          xsi:type="ecore:EAttribute"
          href="http://cdc.dwd.de/common/weather#//MOSMIXSWeatherReport/windDirection"/>
    </resources>
  </services>
  
  <services mid="temperature">
    <name name="Temperature"/>
    <resources
        name="Temperature"
        unit="degrees"
        mid="temperature">
      <eType
          xsi:type="ecore:EDataType"
          href="http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
      <valueFeature
          xsi:type="ecore:EAttribute"
          href="http://cdc.dwd.de/common/weather#//MOSMIXSWeatherReport/tempAboveSurface5"/>
    </resources>
    <resources
        name="Min Temperature"
        unit="degrees"
        mid="min">
      <eType
          xsi:type="ecore:EDataType"
          href="http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
      <valueFeature
          xsi:type="ecore:EAttribute"
          href="http://cdc.dwd.de/common/weather#//MOSMIXSWeatherReport/tempMinLast12"/>
    </resources>
    <resources
        name="Max Temperature"
        unit="degrees"
        mid="max">
      <eType
          xsi:type="ecore:EDataType"
          href="http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
      <valueFeature
          xsi:type="ecore:EAttribute"
          href="http://cdc.dwd.de/common/weather#//MOSMIXSWeatherReport/tempMaxLast12"/>
    </resources>
  </services>
  
  <services mid="pressure">
    <name name="Pressure"/>
    <resources
        name="Surface Pressure"
        unit="Pa"
        mid="surface">
      <eType
          xsi:type="ecore:EDataType"
          href="http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
      <valueFeature
          xsi:type="ecore:EAttribute"
          href="http://cdc.dwd.de/common/weather#//MOSMIXSWeatherReport/surfacePressure"/>
    </resources>
  </services>
  
  <!-- Optional services as defined in profile -->
  <services mid="cloud">
    <name name="Cloud"/>
    <resources
        name="Coverage"
        unit="%"
        mid="coverage">
      <eType
          xsi:type="ecore:EDataType"
          href="http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <valueFeature
          xsi:type="ecore:EAttribute"
          href="http://cdc.dwd.de/common/weather#//MOSMIXSWeatherReport/cloudCoverTotal"/>
    </resources>
  </services>
  
</sensinactMapping:ProviderMapping>