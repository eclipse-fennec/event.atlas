<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reusable persistence rules (WP-SN-2).

  Rules are CONTAINED here (defined once) and referenced from resource mappings via
  non-containment references, so several resources can share the same rule instance.
  See EcoWittPersistenceMapping.xmi for the referencing side.
-->
<mapping:PersistenceRuleRegistry
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:mapping="https://fennec.eclipse.org/event.atlas/mapping/1.0"
    xsi:schemaLocation="https://fennec.eclipse.org/event.atlas/mapping/1.0 ../sensinact-mapping.ecore">

  <!-- Change rules: decide whether a value change is forwarded to the history provider -->
  <changeRules xsi:type="mapping:PercentageChangeRule"   id="pct-5"        name="On 5% change"         percentage="5.0"/>
  <changeRules xsi:type="mapping:AbsoluteChangeRule"     id="abs-2"        name="On 2-unit change"     delta="2.0"/>
  <changeRules xsi:type="mapping:CountChangeRule"        id="every-5"      name="Every 5th reading"    n="5"/>
  <changeRules xsi:type="mapping:TimeThrottleChangeRule" id="throttle-10m" name="At most every 10 min" interval="10" intervalUnit="MINUTES"/>

  <!-- Deletion rules: control retention/cleanup of stored history data -->
  <deletionRules id="keep-90d" name="Keep 90 days" retention="90"  retentionUnit="DAYS" cleanupInterval="1" cleanupIntervalUnit="DAYS"/>
  <deletionRules id="keep-1y"  name="Keep 1 year"  retention="365" retentionUnit="DAYS" cleanupInterval="7" cleanupIntervalUnit="DAYS"/>
</mapping:PersistenceRuleRegistry>
