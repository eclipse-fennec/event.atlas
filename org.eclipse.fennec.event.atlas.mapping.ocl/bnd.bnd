Bundle-Name: Fennec Event Atlas :: Mapping OCL Expressions
Bundle-Description: Evaluates the OCL expression a mapping's FeatureMapping carries. It is the \
 only bundle here that depends on an expression language: the mapping engine declares the \
 ExpressionEvaluator port and reads an expression only where an implementation is deployed, so \
 a runtime without this bundle maps exactly as before.

-workingset: SensiNact

-library: enableEMF

-buildpath: \
	org.eclipse.fennec.event.atlas.mapping;version=snapshot,\
	org.eclipse.fennec.m2x.ocl.api;version=latest,\
	org.eclipse.fennec.m2x.ocl.model;version=latest,\
	org.eclipse.fennec.emf.osgi.metadata;version=latest

# The engine and its parser are needed to exercise the real thing in a plain JUnit test; at
# runtime they arrive as services and Declarative Services wires them.
-testpath: \
	org.eclipse.fennec.m2x.ocl.engine;version=latest,\
	org.eclipse.fennec.m2x.ocl.parser;version=latest,\
	org.eclipse.fennec.m2x.unit;version=latest,\
	org.antlr.antlr4-runtime;version=latest
