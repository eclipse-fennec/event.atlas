Bundle-Name: SensiNact Southbound Common
Bundle-Description: Transport-agnostic ingress shared by the southbound adapters: \
 deserializes a raw payload into EObjects through the runtime ResourceSet (nsURI \
 resolution local-first, then Model Atlas fetch-on-miss) and pushes them into sensinact \
 via the InstancePusher, reporting every drop reason instead of throwing.

-workingset: SensiNact

-library: enableEMF

-buildpath: \
	org.eclipse.emf.ecore.xmi;version=latest,\
	org.eclipse.fennec.emf.osgi.api;version=latest,\
	org.eclipse.fennec.event.atlas.mapping;version=snapshot

