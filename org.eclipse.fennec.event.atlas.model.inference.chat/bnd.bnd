Bundle-Name: Event Atlas Model Inference Chat Completion Adapter
Bundle-Description: Binds model inference's ChatCompletion port to a Fennec AI \
 ChatCompletionService, and reads the agent's answer out of the response's content blocks. \
 The whole reason it is a bundle of its own: it is the only place that depends on an AI \
 stack, so a runtime without one simply does not deploy it - and the inference bundle stays \
 free of both that dependency and of EMF.

-workingset: SensiNact

src: src-gen,src
# sets the usually required buildpath using the bnd library, you can extend it with the normal -buildpath to your liking
-library: enableEMF

# The code generation takes a bit of time and makes the build a bit slower.
# It might be a good idea to put comments around it, when you don't need it
-generate:\
	model/inference.genmodel;\
		generate=fennecEMF;\
		genmodel=model/inference.genmodel;\
		output=src-gen
# Add this attribute to find some logging information
#		logfile=test.log;\

# If this is not done with a instruction namespace, bnd would think you like
# to take full control over whats exported and imported and will ignore @Export
# Bundle Annotations		
-includeresource.model: model=model

-buildpath: \
	org.eclipse.fennec.event.atlas.model.inference;version=snapshot,\
	org.eclipse.fennec.ai.chat.completion.api;version=latest,\
	org.eclipse.fennec.ai.apis.meta.model;version=latest,\
	org.eclipse.fennec.codec;version=latest,\
	org.eclipse.fennec.codec.api;version=latest,\
	org.osgi.util.promise;version=latest
