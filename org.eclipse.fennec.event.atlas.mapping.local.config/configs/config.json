{
  ":configurator:resource-version": 1,
  ":configurator:symbolicname": "org.eclipse.fennec.event.atlas.mapping.local.config",
  ":configurator:version": "1.0.0",

  "org.eclipse.fennec.model.atlas.rest.client~jena": {
    "base.uri": "http://localhost:8086/atlas/rest",
    "scope.allow.list": ["jena"],
    "drift.check.interval.ms": 10000
  },

  "FileEObjectProvider~mappings": {
    "emf.eobject.provider.name": "mapping-files"
  },

  "EObjectRegistry~mappings": {
    "name": "sensinact-mappings",
    "initialProvider.target": "(emf.eobject.provider.name=mapping-files)"
  },

  "AtlasEObjectProvider~jena": {
    "atlasScope.target": "(atlas.scope=jena)",
    "writer.target": "(emf.eobject.registry.name=sensinact-mappings)",
    "emf.eobject.provider.name": "atlas-jena",
    "registries": ["sensinactmapping"],
    "key.feature": "mid",
    "required.nsuris": ["https://fennec.eclipse.org/event.atlas/mapping/1.0"],
    "refresh.interval.ms": 60000
  },

  "sensinact.session.manager": {
    "auth.policy": "ALLOW_ALL"
  },
  
  "sensinact.southbound.mqtt~local": {
    "id": "local-broker",
    "protocol": "tcp",
    "host": "localhost",
    "port": 1883,
    "topics": ["eventatlas/#"]
  },

  "event.atlas.southbound.mqtt~weather": {
    "mqttTopics": ["eventatlas/weather"],
    "mqtt.handler.id": "local-broker",
    "format": "xmi",
    "name": "weather-mqtt"
  },
  
  "JakartarsServletWhiteboardRuntimeComponent": {
    "osgi.jakartars.name": "eventatlas.rest"
  }
  
  
}
