{
  ":configurator:resource-version": 1,
  ":configurator:symbolic-name": "org.eclipse.fennec.event.atlas.mapping.local.config",
  ":configurator:version": "1.0.0",

  /* Domain EPackages come from the Atlas, not from model bundles in the runtime, and so do the
   * mappings and profiles below.
   *
   * The Atlas runs as a local container on 8080 (docker-compose-jena.yml in
   * eclipse-fennec/model.atlas, published as-is). The runtime's own HTTP whiteboard therefore
   * moves to 8090 in sensinact.json - the two cannot both own 8080.
   *
   * EAGER pre-fetches the whole scope at activation instead of resolving one nsURI at a time, so
   * the mapping sync below finds the domain packages. Worth keeping even though the client now
   * resolves the references a fetched EPackage makes into other packages: it turns a layered
   * domain model (a shared base package plus vendor extensions) into a start-up cost rather than
   * a first-payload one. register.in.global.registry mirrors them into EPackage.Registry.INSTANCE,
   * where EMF deserialization looks.
   *
   * `eager.stages` is deliberately absent - empty is the default and exposes one stage-free
   * registry per scope, resolving that scope's own final stage server-side, which is correct
   * whatever a scope names its stages (the jena registries here stage draft -> release). */
  "org.eclipse.fennec.model.atlas.rest.client~jena": {
    "base.uri": "http://localhost:8080/atlas/rest",
    "scope.allow.list": ["jena"],
    "default.scope": "jena",
    "mode": "EAGER",
    "eager.scopes": ["jena"],
    "register.in.global.registry": true,

    /* Required alongside register.in.global.registry, same reason as in
     * ...mapping.inference.config (which carries the full explanation) and
     * ...mapping.docker.config. Short version: EAGER mode sweeps what
     * GET /{scope}/schema/all returns, and that resolves inheritance - 18 of the 22 packages a
     * `jena` sweep sees are owned by the parent `atlas` scope. Mirroring one of those into
     * EPackage.Registry.INSTANCE while the generated package's slot is still empty makes the
     * generated factory die casting it:
     * `EFactoryImpl cannot be cast to ScopeApiFactory`.
     *
     * model.atlas #227 does not cover it - putIfAbsent protects an OCCUPIED slot and this one is
     * empty. The real fix is for EAGER to be strict about eager.scopes; sketched in
     * nsc/docs/issue-eager-scopes-should-not-sweep-inherited-parents.md, and this list goes away
     * when that lands.
     *
     * This runtime had never hit it - it is order-dependent, and a factory's <clinit> runs once -
     * but it carries both halves of the trigger (the generated scope.api bundle and the Atlas
     * EObject provider), so it was latent rather than safe. Keep in step with the other two
     * copies. */
    "nsuri.deny.list": [
      "http://eclipse.org/fennec/model/atlas/management/1.0.0",
      "http://eclipse.org/fennec/model/atlas/management/api/1.0.0",
      "http://eclipse.org/fennec/model/atlas/rest/1.0",
      "http://eclipse.org/fennec/model/atlas/scope/api/1.0.0",
      "http://eclipse.org/fennec/model/atlas/workflow/api/1.0.0",
      "http://www.eclipse.org/emf/2002/Ecore",
      "http://www.eclipse.org/emf/2003/XMLType",
      "http://www.eclipse.org/fennec/m2x/ocl/1.0",
      "http://www.eclipse.org/uml2/5.0.0/Types",
      "http://www.eclipse.org/uml2/5.0.0/UML",
      "http://www.gme.org/cocl/1.0",
      "http://www.gme.org/datagen/1.0",
      "http://www.w3.org/XML/1998/namespace",
      "https://dg.de/1.0",
      "https://eclipse.org/fennec/codec/1.0.0",
      "https://eclipse.org/fennec/emf/osgi/metadata/1.0.0",
      "https://fennec.eclipse.org/event.atlas/mapping/1.0"
    ],

    /* Required alongside register.in.global.registry, for the same reason as in
     * ...mapping.inference.config and ...mapping.docker.config - the full explanation is in the
     * inference config. Short version: the eager sweep of a scope that inherits the `atlas`
     * parent mirrors a DYNAMIC copy of a system nsURI into EPackage.Registry.INSTANCE while the
     * generated package's slot is still empty, and the generated factory then dies casting it
     * (`EFactoryImpl cannot be cast to ScopeApiFactory`). model.atlas #227 made the mirror
     * non-clobbering, which does not help: putIfAbsent protects an occupied slot and this one is
     * empty.
     *
     * This runtime had never hit it - it is order-dependent, and a factory's <clinit> runs once -
     * but it carries both halves of the trigger (the generated scope.api bundle and the Atlas
     * EObject provider), so it was latent rather than safe. Keep in step with the other two
     * copies. */
    "nsuri.deny.list": [
      "http://eclipse.org/fennec/model/atlas/management/1.0.0",
      "http://eclipse.org/fennec/model/atlas/management/api/1.0.0",
      "http://eclipse.org/fennec/model/atlas/rest/1.0",
      "http://eclipse.org/fennec/model/atlas/scope/api/1.0.0",
      "http://eclipse.org/fennec/model/atlas/workflow/api/1.0.0",
      "http://www.eclipse.org/emf/2002/Ecore",
      "http://www.eclipse.org/emf/2003/XMLType",
      "http://www.eclipse.org/fennec/m2x/ocl/1.0",
      "http://www.eclipse.org/uml2/5.0.0/Types",
      "http://www.eclipse.org/uml2/5.0.0/UML",
      "http://www.gme.org/cocl/1.0",
      "http://www.gme.org/datagen/1.0",
      "http://www.w3.org/XML/1998/namespace",
      "https://dg.de/1.0",
      "https://eclipse.org/fennec/codec/1.0.0",
      "https://eclipse.org/fennec/emf/osgi/metadata/1.0.0",
      "https://fennec.eclipse.org/event.atlas/mapping/1.0"
    ],
    "drift.check.interval.ms": 10000
  },

  /* Both file providers carry no `locations`: an empty list is a valid, empty initial state,
   * and it exists only to satisfy each registry's `initialProvider.target`. Locally all content
   * comes from the Atlas providers below. */
  "FileEObjectProvider~mappings": {
    "emf.eobject.provider.name": "mapping-files"
  },

  "EObjectRegistry~mappings": {
    "name": "sensinact-mappings",
    "initialProvider.target": "(emf.eobject.provider.name=mapping-files)"
  },

  "FileEObjectProvider~profiles": {
    "emf.eobject.provider.name": "profile-files"
  },

  /* Without this registry MappingProfileRegistryImpl never binds, and every mapping carrying a
   * `profile` reference is skipped rather than registered profile-less - the profile decides
   * provider identity, so ProviderMappingRegistryImpl.resolveProfile refuses to guess. */
  "EObjectRegistry~profiles": {
    "name": "sensinact-profiles",
    "initialProvider.target": "(emf.eobject.provider.name=profile-files)"
  },

  "AtlasEObjectProvider~jena": {
    "atlasScope.target": "(atlas.scope=jena)",
    "writer.target": "(emf.eobject.registry.name=sensinact-mappings)",
    "emf.eobject.provider.name": "atlas-jena",
    "registries": ["sensinactmapping"],
    "key.feature": "mid",
    /* Gate, not a loader: the mapping sync waits until these EPackages are registered. */
    "required.nsuris": [
      "https://fennec.eclipse.org/event.atlas/mapping/1.0",
      "https://datainmotion.de/demo/m5airq/1.0",
      "http://data-in-motion.biz/waterparc/domain"
    ],
    "refresh.interval.ms": 60000
  },

  /* Profiles come from their own Atlas registry: `sensinactmapping` pins root.eclass.uri to
   * ProviderMapping, so a MappingProfile cannot live there. `key.feature` is profileId, which is
   * what a mapping's profile proxy fragment resolves against. */
  "AtlasEObjectProvider~jenaProfiles": {
    "atlasScope.target": "(atlas.scope=jena)",
    "writer.target": "(emf.eobject.registry.name=sensinact-profiles)",
    "emf.eobject.provider.name": "atlas-jena-profiles",
    "registries": ["sensinactprofile"],
    "key.feature": "profileId",
    "required.nsuris": ["https://fennec.eclipse.org/event.atlas/mapping/1.0"],
    "refresh.interval.ms": 60000
  },

  /* JSON payloads do not name their model; the codec types them through the discriminator
   * registry named here. One registry and one discriminator path per runtime - every JSON
   * device family shares it (see docs/json-southbound-typing.md).
   *
   * The id must match the `http://eclipse.org/fennec/codec/typeMapping/{id}` annotation source
   * the deployed models actually carry (AnnotationSources.TYPE_MAPPING_PREFIX plus the id) - an
   * id no model annotates for types nothing at all, silently. Overridable because it is a
   * property of the model set a runtime is loaded with, not of the runtime: `jena-sensors` is
   * the m5airq/waterparc family, while the lorawan/em310udl fixtures in the jena atlas annotate
   * for `lorawan`. Whatever an inference run's agent discovers from the sibling models it finds
   * is the id it will annotate its draft for, which is why the prompt does not mention one. */
  "event.atlas.southbound.ingest": {
    "codec.typeMapId": "$[env:EVENTATLAS_CODEC_TYPE_MAP_ID;default=$[prop:EVENTATLAS_CODEC_TYPE_MAP_ID;default=jena-sensors]]"
  },

  /* --- local dev broker: weather simulator (XMI) + a generic JSON channel --- */

  "sensinact.southbound.mqtt~local": {
    "id": "local-broker",
    "protocol": "tcp",
    "host": "localhost",
    "port": 1883,
    "topics": ["eventatlas/#"]
  },

  "event.atlas.southbound.mqtt~weather": {
    "mqttTopics": ["eventatlas/weather"],
    "mqtt.handler.id": "local-broker",
    "format": "xmi",
    "name": "weather-mqtt"
  },

  /* A JSON channel next to the XMI one, as in the docker config: the same broker connection,
   * split by topic. A message on a subscribed topic that matches neither filter is received and
   * silently dropped, so keep the union covering the broker's `topics`. */
  "event.atlas.southbound.mqtt~json": {
    "mqttTopics": ["eventatlas/json/#"],
    "mqtt.handler.id": "local-broker",
    "format": "json",
    "name": "local-mqtt-json"
  },

  /* --- M5AirQ air quality device (JSON, discriminator `deduplicationId`) --- */

  "sensinact.southbound.mqtt~airquality": {
    "id": "airquality-broker",
    "protocol": "tcp",
    "host": "$[env:AIRQ_MQTT_HOST;default=datainmotion.de]",
    "port": "$[env:AIRQ_MQTT_PORT;default=1883;type=Integer]",
    "user": "$[env:AIRQ_MQTT_USER;default=demo]",
    ".password": "$[env:AIRQ_MQTT_PASSWORD;default=]",
    "topics": ["airquality/#"]
  },

  "event.atlas.southbound.mqtt~airquality": {
    "mqttTopics": ["airquality/sensor"],
    "mqtt.handler.id": "airquality-broker",
    "format": "json",
    "name": "airquality-mqtt"
  },

  /* --- waterpark simulation (JSON since the sim's emf_sink switched from XMI) --- */

  "sensinact.southbound.mqtt~waterpark": {
    "id": "waterpark-broker",
    "protocol": "tcp",
    "host": "$[env:WATERPARK_MQTT_HOST;default=localhost]",
    "port": "$[env:WATERPARK_MQTT_PORT;default=1885;type=Integer]",
    "topics": ["waterpark/sensors/#"]
  },

  "event.atlas.southbound.mqtt~waterpark": {
    "mqttTopics": ["waterpark/sensors/#"],
    "mqtt.handler.id": "waterpark-broker",
    "format": "json",
    "name": "waterpark-mqtt"
  },

  /* --- model inference: a draft model for payloads this runtime has no model for ---------
   *
   * All of this is optional. Without these four configurations - or without the bundles they
   * configure - unknown payloads are dropped exactly as they were before, and the sample
   * collector below simply reports what it would have handed over.
   *
   * The chain is: PayloadIngest offers an unhandled payload to the collector, the collector
   * gathers a set of distinctly shaped payloads per channel, and model inference spends one
   * agentic completion on the closed set. The agent authors and publishes through the MCP
   * server's own tools; what comes back is a receipt. Nothing here registers a model locally -
   * a draft is promoted by a human, and the runtime resolves it on the next payload. */

  /* The remote metamodel MCP server, registered as an addressable MCPEndpoint without this
   * framework hosting an MCP server of its own. `server.name` is also the service property the
   * chat completion's mcpServers.target filters on, and the name the request's mcp_toolset
   * refers to - change it in both places or the completion will not activate.
   *
   * `server.url` must be reachable FROM ANTHROPIC, not from this runtime. The client sends it as
   * an `mcp_servers` entry of type `url`, i.e. through Anthropic's MCP connector, so the API
   * dials the server itself and this framework never opens the connection. The localhost default
   * below is a placeholder that cannot work in a real run - point it at a public HTTPS address
   * for the metamodel runtime's servlet (a tunnel is enough for a test). Nothing validates it:
   * RemoteMCPEndpoint never probes the URL, so a wrong one first shows up as a failed run. */
  "RemoteMCPEndpoint~metamodel": {
    "server.name": "metamodel",
    "server.url": "$[env:METAMODEL_MCP_URL;default=$[prop:METAMODEL_MCP_URL;default=http://localhost:8099/mcp/inference]]"
  },

  /* The Claude client. Note `mcpServers.target`: the reference is 1..n and unfiltered by
   * default, so without this it would bind ANY MCPEndpoint in the framework - including a
   * co-hosted one - and the agent would be handed the wrong tool surface. Which tool surface
   * that is, is decided entirely by the endpoint's URL - see the note on scoping below.
   *
   * `api.key` is read from the environment; the key itself never lives in configuration.
   * `download.file.folder` is required even though only the batch service reads it: the shared
   * OCD marks it mandatory, so the component does not activate without it.
   *
   * The values are read as $[env:NAME;default=$[prop:NAME;default=...]] - an exported
   * environment variable first, then a system property (which is what secrets.bndrun sets
   * through -runvm), then the default here. The numeric ones carry no `type=Integer`: a nested
   * placeholder and a type directive would have to survive the same `;`-separated parse, and
   * Declarative Services coerces a numeric string to the component's int either way.
   *
   * `max.tokens` is the per-answer output ceiling. The component's own default of 1024 is far
   * too small for a turn that authors a package, and hitting it truncates the answer mid-way.
   *
   * `mcp.authorization.token` is what Anthropic presents to the MCP server as
   * `Authorization: Bearer <token>`, and it must equal `auth.token` on that servlet's
   * HttpMCPServerComponent configuration. It is not optional once the endpoint is tunnelled:
   * McpAuthenticationFilter trusts direct loopback callers only while no token is configured,
   * and a tunnelled request arrives from loopback *carrying a forwarding header*, which it
   * refuses by design. Empty here means the request goes out with no credential and the server
   * answers 403 - which reads like a transport fault and is not one.
   *
   * `mcp.tools.enabled` is NOT optional, and it is not merely an allow-list: ClaudeHelper always
   * builds the toolset with `default_config {enabled:false}` and re-enables only what this array
   * names. Leaving it out leaves every tool on the server disabled - the agent gets a tool
   * surface of nothing - so it has to be listed here even when the endpoint is already scoped.
   *
   * It mirrors the 21 tools `inference_tool_provider` serves on /mcp/inference, which is the
   * task-scoped servlet: discovery, authoring, validation, register and publish. What manages
   * datasets beyond authoring, deletes, replays a recipe or unregisters a package is not served
   * there at all, and nothing on it can promote a draft to a released stage - that stays a human
   * decision. Scoping at both ends means a name that drifts out of the server's provider stops
   * being callable rather than silently widening the surface. */
  "ClaudeChatCompletionService": {
    "api.key": "$[env:ANTHROPIC_API_KEY;default=$[prop:ANTHROPIC_API_KEY;default=]]",
    "base.url": "$[env:ANTHROPIC_BASE_URL;default=$[prop:ANTHROPIC_BASE_URL;default=https://api.anthropic.com/v1/messages]]",
    "model": "$[env:INFERENCE_MODEL;default=$[prop:INFERENCE_MODEL;default=claude-opus-5]]",
    "max.tokens": "$[env:INFERENCE_MAX_TOKENS;default=$[prop:INFERENCE_MAX_TOKENS;default=16000]]",
    "download.file.folder": "$[env:INFERENCE_DOWNLOAD_FOLDER;default=$[prop:INFERENCE_DOWNLOAD_FOLDER;default=/tmp/eventatlas-inference]]",
    "mcpServers.target": "(server.name=metamodel)",
    "mcp.authorization.token": "$[env:METAMODEL_MCP_TOKEN;default=$[prop:METAMODEL_MCP_TOKEN;default=]]",
    "mcp.tools.enabled": [
      "list_metamodel",
      "describe_eclass",
      "export_package",
      "list_annotation_sources",
      "find_classes_by_annotation",
      "find_features_by_annotation",
      "describe_aspects",
      "create_dataset",
      "create_epackage",
      "add_eclass",
      "add_eattribute",
      "add_ereference",
      "add_eannotation",
      "add_eenum",
      "add_eenum_literal",
      "modify_feature",
      "create_from_json",
      "export_dataset",
      "register_package",
      "list_registry",
      "post_to_model_atlas"
    ]
  },

  /* The namespace the agent may publish under - the one thing it cannot work out for itself.
   * Everything else about the model is left to discovery. */
  "event.atlas.model.inference": {
    "namespace": "$[env:INFERENCE_NAMESPACE;default=$[prop:INFERENCE_NAMESPACE;default=https://fennec.eclipse.org/event.atlas/inferred]]",
    "maxRunsPerInterval": "$[env:INFERENCE_MAX_RUNS;default=$[prop:INFERENCE_MAX_RUNS;default=3]]",
    "intervalSeconds": 3600,
    "timeoutSeconds": 600
  },

  /* Left at its defaults except for the wait: a dev broker publishes often, and half an hour
   * is a long time to watch nothing happen. */
  "event.atlas.southbound.sampling": {
    /* Sampling is off unless asked for - see the collector's `enabled` default. This runtime
     * exists to exercise the chain, so it asks. */
    "enabled": true,
    "maxWaitSeconds": "$[env:SAMPLING_MAX_WAIT;default=$[prop:SAMPLING_MAX_WAIT;default=300]]"
  }
}
