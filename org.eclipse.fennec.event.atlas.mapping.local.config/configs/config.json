{
  ":configurator:resource-version": 1,
  ":configurator:symbolic-name": "org.eclipse.fennec.event.atlas.mapping.local.config",
  ":configurator:version": "1.0.0",

  /* Domain EPackages come from the Atlas, not from model bundles in the runtime, and so do the
   * mappings and profiles below.
   *
   * The Atlas runs as a local container on 8080 (docker-compose-jena.yml in
   * eclipse-fennec/model.atlas, published as-is). The runtime's own HTTP whiteboard therefore
   * moves to 8090 in sensinact.json - the two cannot both own 8080.
   *
   * EAGER pre-fetches the whole scope at activation instead of resolving one nsURI at a time, so
   * the mapping sync below finds the domain packages. Worth keeping even though the client now
   * resolves the references a fetched EPackage makes into other packages: it turns a layered
   * domain model (a shared base package plus vendor extensions) into a start-up cost rather than
   * a first-payload one. register.in.global.registry mirrors them into EPackage.Registry.INSTANCE,
   * where EMF deserialization looks.
   *
   * `eager.stages` is deliberately absent - empty is the default and exposes one stage-free
   * registry per scope, resolving that scope's own final stage server-side, which is correct
   * whatever a scope names its stages (the jena registries here stage draft -> release). */
  "org.eclipse.fennec.model.atlas.rest.client~jena": {
    "base.uri": "http://localhost:8080/atlas/rest",
    "scope.allow.list": ["jena"],
    "default.scope": "jena",
    "mode": "EAGER",
    "eager.scopes": ["jena"],
    "register.in.global.registry": true,
    "drift.check.interval.ms": 10000
  },

  /* Both file providers carry no `locations`: an empty list is a valid, empty initial state,
   * and it exists only to satisfy each registry's `initialProvider.target`. Locally all content
   * comes from the Atlas providers below. */
  "FileEObjectProvider~mappings": {
    "emf.eobject.provider.name": "mapping-files"
  },

  "EObjectRegistry~mappings": {
    "name": "sensinact-mappings",
    "initialProvider.target": "(emf.eobject.provider.name=mapping-files)"
  },

  "FileEObjectProvider~profiles": {
    "emf.eobject.provider.name": "profile-files"
  },

  /* Without this registry MappingProfileRegistryImpl never binds, and every mapping carrying a
   * `profile` reference is skipped rather than registered profile-less - the profile decides
   * provider identity, so ProviderMappingRegistryImpl.resolveProfile refuses to guess. */
  "EObjectRegistry~profiles": {
    "name": "sensinact-profiles",
    "initialProvider.target": "(emf.eobject.provider.name=profile-files)"
  },

  "AtlasEObjectProvider~jena": {
    "atlasScope.target": "(atlas.scope=jena)",
    "writer.target": "(emf.eobject.registry.name=sensinact-mappings)",
    "emf.eobject.provider.name": "atlas-jena",
    "registries": ["sensinactmapping"],
    "key.feature": "mid",
    /* Gate, not a loader: the mapping sync waits until these EPackages are registered. */
    "required.nsuris": [
      "https://fennec.eclipse.org/event.atlas/mapping/1.0",
      "https://datainmotion.de/demo/m5airq/1.0",
      "http://data-in-motion.biz/waterparc/domain"
    ],
    "refresh.interval.ms": 60000
  },

  /* Profiles come from their own Atlas registry: `sensinactmapping` pins root.eclass.uri to
   * ProviderMapping, so a MappingProfile cannot live there. `key.feature` is profileId, which is
   * what a mapping's profile proxy fragment resolves against. */
  "AtlasEObjectProvider~jenaProfiles": {
    "atlasScope.target": "(atlas.scope=jena)",
    "writer.target": "(emf.eobject.registry.name=sensinact-profiles)",
    "emf.eobject.provider.name": "atlas-jena-profiles",
    "registries": ["sensinactprofile"],
    "key.feature": "profileId",
    "required.nsuris": ["https://fennec.eclipse.org/event.atlas/mapping/1.0"],
    "refresh.interval.ms": 60000
  },

  /* JSON payloads do not name their model; the codec types them through the discriminator
   * registry named here. One registry and one discriminator path per runtime - every JSON
   * device family shares it (see docs/json-southbound-typing.md). */
  "event.atlas.southbound.ingest": {
    "codec.typeMapId": "jena-sensors"
  },

  /* --- local dev broker: weather simulator (XMI) + a generic JSON channel --- */

  "sensinact.southbound.mqtt~local": {
    "id": "local-broker",
    "protocol": "tcp",
    "host": "localhost",
    "port": 1883,
    "topics": ["eventatlas/#"]
  },

  "event.atlas.southbound.mqtt~weather": {
    "mqttTopics": ["eventatlas/weather"],
    "mqtt.handler.id": "local-broker",
    "format": "xmi",
    "name": "weather-mqtt"
  },

  /* A JSON channel next to the XMI one, as in the docker config: the same broker connection,
   * split by topic. A message on a subscribed topic that matches neither filter is received and
   * silently dropped, so keep the union covering the broker's `topics`. */
  "event.atlas.southbound.mqtt~json": {
    "mqttTopics": ["eventatlas/json/#"],
    "mqtt.handler.id": "local-broker",
    "format": "json",
    "name": "local-mqtt-json"
  },

  /* --- M5AirQ air quality device (JSON, discriminator `deduplicationId`) --- */

  "sensinact.southbound.mqtt~airquality": {
    "id": "airquality-broker",
    "protocol": "tcp",
    "host": "$[env:AIRQ_MQTT_HOST;default=datainmotion.de]",
    "port": "$[env:AIRQ_MQTT_PORT;default=1883;type=Integer]",
    "user": "$[env:AIRQ_MQTT_USER;default=demo]",
    ".password": "$[env:AIRQ_MQTT_PASSWORD;default=]",
    "topics": ["airquality/#"]
  },

  "event.atlas.southbound.mqtt~airquality": {
    "mqttTopics": ["airquality/sensor"],
    "mqtt.handler.id": "airquality-broker",
    "format": "json",
    "name": "airquality-mqtt"
  },

  /* --- waterpark simulation (JSON since the sim's emf_sink switched from XMI) --- */

  "sensinact.southbound.mqtt~waterpark": {
    "id": "waterpark-broker",
    "protocol": "tcp",
    "host": "$[env:WATERPARK_MQTT_HOST;default=localhost]",
    "port": "$[env:WATERPARK_MQTT_PORT;default=1885;type=Integer]",
    "topics": ["waterpark/sensors/#"]
  },

  "event.atlas.southbound.mqtt~waterpark": {
    "mqttTopics": ["waterpark/sensors/#"],
    "mqtt.handler.id": "waterpark-broker",
    "format": "json",
    "name": "waterpark-mqtt"
  },

  /* --- model inference: a draft model for payloads this runtime has no model for ---------
   *
   * All of this is optional. Without these four configurations - or without the bundles they
   * configure - unknown payloads are dropped exactly as they were before, and the sample
   * collector below simply reports what it would have handed over.
   *
   * The chain is: PayloadIngest offers an unhandled payload to the collector, the collector
   * gathers a set of distinctly shaped payloads per channel, and model inference spends one
   * agentic completion on the closed set. The agent authors and publishes through the MCP
   * server's own tools; what comes back is a receipt. Nothing here registers a model locally -
   * a draft is promoted by a human, and the runtime resolves it on the next payload. */

  /* The remote metamodel MCP server, registered as an addressable MCPEndpoint without this
   * framework hosting an MCP server of its own. `server.name` is also the service property the
   * chat completion's mcpServers.target filters on, and the name the request's mcp_toolset
   * refers to - change it in both places or the completion will not activate. */
  "RemoteMCPEndpoint~metamodel": {
    "server.name": "metamodel",
    "server.url": "$[env:METAMODEL_MCP_URL;default=http://localhost:8181/mcp/emf]"
  },

  /* The Claude client. Note `mcpServers.target`: the reference is 1..n and unfiltered by
   * default, so without this it would bind ANY MCPEndpoint in the framework - including a
   * co-hosted one - and the agent would be handed the wrong tool surface.
   *
   * `api.key` is read from the environment; the key itself never lives in configuration.
   * `download.file.folder` is required even though only the batch service reads it: the shared
   * OCD marks it mandatory, so the component does not activate without it.
   *
   * `max.tokens` is the per-answer output ceiling. The component's own default of 1024 is far
   * too small for a turn that authors a package, and hitting it truncates the answer mid-way.
   *
   * `mcp.tools.enabled` is the allow-list, and it is deliberately task-scoped - see CLAUDE.md
   * for the measured reason. 21 of the server's 38 tools: discovery, authoring, one validation
   * tool, register and publish. Everything that manages datasets, deletes, replays a recipe or
   * unregisters a package is left out, and nothing here can promote a draft to a released
   * stage - that stays a human decision. */
  "ClaudeChatCompletionService": {
    "api.key": "$[env:ANTHROPIC_API_KEY]",
    "base.url": "$[env:ANTHROPIC_BASE_URL;default=https://api.anthropic.com/v1/messages]",
    "model": "$[env:INFERENCE_MODEL;default=claude-opus-5]",
    "max.tokens": "$[env:INFERENCE_MAX_TOKENS;default=16000;type=Integer]",
    "download.file.folder": "$[env:INFERENCE_DOWNLOAD_FOLDER;default=/tmp/eventatlas-inference]",
    "mcpServers.target": "(server.name=metamodel)",
    "mcp.tools.enabled": [
      "list_registry",
      "list_metamodel",
      "describe_eclass",
      "export_package",
      "find_class_by_name",
      "find_classes_by_annotation",
      "find_features_by_annotation",
      "list_annotation_sources",
      "create_epackage",
      "add_eclass",
      "add_eattribute",
      "add_ereference",
      "add_eannotation",
      "add_eenum",
      "add_eenum_literal",
      "add_edatatype",
      "modify_feature",
      "create_from_json",
      "describe_package_metadata",
      "register_package",
      "post_to_model_atlas"
    ]
  },

  /* The namespace the agent may publish under, and the codec type map it must annotate for.
   * codecTypeMapId has to match `codec.typeMapId` on event.atlas.southbound.ingest above: a
   * model annotated for a different map deserializes nothing in this runtime. */
  "event.atlas.model.inference": {
    "namespace": "$[env:INFERENCE_NAMESPACE;default=https://fennec.eclipse.org/event.atlas/inferred]",
    "codecTypeMapId": "jena-sensors",
    "maxRunsPerInterval": "$[env:INFERENCE_MAX_RUNS;default=3;type=Integer]",
    "intervalSeconds": 3600,
    "timeoutSeconds": 600
  },

  /* Left at its defaults except for the wait: a dev broker publishes often, and half an hour
   * is a long time to watch nothing happen. */
  "event.atlas.southbound.sampling": {
    "maxWaitSeconds": "$[env:SAMPLING_MAX_WAIT;default=300;type=Integer]"
  }
}
